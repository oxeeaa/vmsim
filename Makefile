CC      := gcc
CFLAGS  := -Wall -Wextra -Wpedantic -std=c23 -pthread

BUILD   := build
INCLUDE := include
CODE    := code

MAIN    := $(BUILD)/vmsim
TEST    := $(BUILD)/test

.PHONY: build test run clean

build: $(MAIN)

test: $(TEST)
	./$(TEST)

run: $(MAIN)
	./$(MAIN)

$(MAIN): $(CODE)/main/Main.c $(INCLUDE)/Simulator.c $(INCLUDE)/Algorithm.c $(INCLUDE)/PageTable.c
	$(CC) $(CFLAGS) -I$(INCLUDE) $^ -o $@

$(TEST): $(CODE)/tests/Main.c
	$(CC) $(CFLAGS) -I$(INCLUDE) $^ -o $@

clean:
	rm -f $(MAIN) $(TEST)
